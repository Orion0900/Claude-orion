# Required: Claude writes the summaries.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-haiku-4-5 (cheapest, ~$0.06 per two-hour episode).
# claude-opus-5 gives the most thorough summaries at ~5x the price.
# CLAUDE_MODEL=claude-haiku-4-5

# Transcription for SPOTIFY links only. YouTube links use free captions and
# need none of this. Set one if you'll paste Spotify links for shows that
# don't publish transcripts in their feed. AssemblyAI works from the audio URL
# (no download, no size limit); OpenAI Whisper needs ffmpeg for files > 25 MB.
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Optional: mirrors to try when YouTube refuses this server's IP.
# YOUTUBE_MIRRORS=https://inv.nadeko.net,https://yewtu.be

# Optional: Spotify Web API credentials make episode lookup more reliable
# than reading the public page. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where finished summaries are stored (a JSON file lives here).
DATA_DIR=./data
PORT=8787
