# Required: Claude writes the summaries.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-haiku-4-5 (cheapest, ~$0.06 per two-hour episode).
# claude-opus-5 gives the most thorough summaries at ~5x the price.
# CLAUDE_MODEL=claude-haiku-4-5

# Transcription. Set at least one unless every show you follow publishes
# transcripts in its RSS feed. AssemblyAI works from the audio URL directly
# (no download, no size limit); OpenAI Whisper needs the file uploaded and
# ffmpeg installed for episodes over 25 MB.
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Optional: Spotify Web API credentials make episode lookup more reliable
# than reading the public page. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where finished summaries are stored (a JSON file lives here).
DATA_DIR=./data
PORT=8787
